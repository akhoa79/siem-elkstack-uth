# Copy this file to .env only when deployment begins. Do not commit .env.
# All password values below are placeholders and must be replaced locally.

# Keep Elasticsearch, Logstash, Kibana, and Winlogbeat on the same release.
ELASTIC_STACK_VERSION=9.5.6

# Local lab time zone used by Logstash date processing and dashboards.
SIEM_TIMEZONE=Asia/Bangkok

# Bind Kibana only to the VMware lab/management network, never the Internet.
KIBANA_PORT=5601

# Use non-privileged collector ports to avoid running Logstash as root.
LOGSTASH_BEATS_PORT=5044
LOGSTASH_SYSLOG_UDP_PORT=5514

# Replace locally with strong, unique values before Docker Compose is started.
ELASTIC_PASSWORD=replace-with-a-strong-local-password
KIBANA_SYSTEM_PASSWORD=replace-with-a-strong-local-password
LOGSTASH_INTERNAL_PASSWORD=replace-with-a-strong-local-password
# Exactly 32+ random characters; used to encrypt Kibana saved objects at rest.
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=replace-with-at-least-32-random-characters

# Do not change these names after the first deployment without updating Compose.
KIBANA_SYSTEM_USER=kibana_system
LOGSTASH_INTERNAL_USER=logstash_internal

# Certificates are generated locally under config/elasticsearch/certs/ and ignored.
CA_CERT_PATH=config/elasticsearch/certs/ca/ca.crt
